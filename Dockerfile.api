FROM python:3.12-slim

ARG CODEQL_VERSION=2.25.6

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PR_ATLAS_ARTIFACT_ROOT=/atlas

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl git unzip ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

RUN curl -fsSL "https://github.com/github/codeql-cli-binaries/releases/download/v${CODEQL_VERSION}/codeql-linux64.zip" -o /tmp/codeql.zip \
    && unzip -q /tmp/codeql.zip -d /opt \
    && ln -s /opt/codeql/codeql /usr/local/bin/codeql \
    && rm /tmp/codeql.zip

COPY codeql ./codeql
RUN codeql pack install codeql/pr-impact

COPY pr_atlas_mvp ./pr_atlas_mvp

EXPOSE 8000

CMD ["uvicorn", "pr_atlas_mvp.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
